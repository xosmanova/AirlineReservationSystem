{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=AirlineReservationDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Business": {
    "TimeZone": "Asia/Baku"
  },
  "Jwt": {
    "Issuer": "AirlineReservation.API",
    "Audience": "AirlineReservation.Client",
    "ExpiryMinutes": 60
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Pricing": {
    "WindowFee": 10.00,
    "AisleFee": 5.00,
    "LastMinuteDays": 3,
    "LastMinuteMultiplier": 1.20
  },
  "AllowedHosts": "*"
}
